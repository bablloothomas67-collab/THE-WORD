# Copy to .env.local for local development. Never commit real values.

# --- Public (bundled into the browser; protected by Row Level Security) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Server-side only (Supabase Edge Function secrets; NEVER prefix with VITE_) ---
OPENAI_API_KEY=
BIBLE_PROVIDER_API_KEY=

# --- Payments (later phase; server-side only) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Application ---
APP_URL=
APP_ENV=development
